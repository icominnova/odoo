<odoo>
    <record id="view_custom_pwa_title_form" model="ir.ui.view">
        <field name="name">custom.pwa.title.form</field>
        <field name="model">custom.pwa.title</field>
        <field name="arch" type="xml">
            <form string="Titre de l'onglet PWA">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_custom_pwa_title_list" model="ir.ui.view">
        <field name="name">custom.pwa.title.list</field>
        <field name="model">custom.pwa.title</field>
        <field name="arch" type="xml">
            <list string="Titres PWA">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_custom_pwa_title" model="ir.actions.act_window">
        <field name="name">Titre Onglet PWA</field>
        <field name="res_model">custom.pwa.title</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_custom_pwa_title_root" name="PWA Personnalisation" sequence="10" web_icon="custom_pwa_manifest,static/description/icon.png"/>
</odoo>
