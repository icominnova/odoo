<odoo>
    <record id="view_custom_pwa_image_form" model="ir.ui.view">
        <field name="name">custom.pwa.image.form</field>
        <field name="model">custom.pwa.image</field>
        <field name="arch" type="xml">
            <form string="Image PWA Personnalisée">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="image" widget="image"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_custom_pwa_image_list" model="ir.ui.view">
        <field name="name">custom.pwa.image.list</field>
        <field name="model">custom.pwa.image</field>
        <field name="arch" type="xml">
            <list string="Images PWA">
                <field name="name"/>
                <field name="image" widget="image"/>
            </list>
        </field>
    </record>

    <record id="action_custom_pwa_image" model="ir.actions.act_window">
        <field name="name">Images PWA</field>
        <field name="res_model">custom.pwa.image</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_custom_pwa_image" name="Image d'onglet" parent="menu_custom_pwa_title_root" action="action_custom_pwa_image" sequence="20"/>
</odoo>
