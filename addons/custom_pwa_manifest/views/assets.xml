<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="custom_favicon" inherit_id="web.layout">
        <xpath expr="//link[@rel='shortcut icon']" position="replace">
            <t t-set="favicon" t-value="request.env['custom.pwa.image'].sudo().search([], order='id desc', limit=1)"/>
            <link rel="shortcut icon" type="image/png" t-att-href="'/web/image/custom.pwa.image/%s/image' % favicon.id if favicon else '/web/image/website/1/favicon'"/>
        </xpath>
    </template>
</odoo>