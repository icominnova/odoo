<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="custom_favicon" inherit_id="web.layout">
        <xpath expr="//link[@rel='shortcut icon']" position="replace">
            <link rel="shortcut icon" type="image/png" href="/custom_pwa_manifest/static/src/img/pwa-icon-192.png"/>
            <link rel="icon" type="image/png" sizes="192x192" href="/custom_pwa_manifest/static/src/img/pwa-icon-192.png"/>
            <link rel="icon" type="image/png" sizes="512x512" href="/custom_pwa_manifest/static/src/img/pwa-icon-512.png"/>
            <link rel="apple-touch-icon" sizes="192x192" href="/custom_pwa_manifest/static/src/img/pwa-icon-192.png"/>
        </xpath>
    </template>
</odoo>
