<odoo>
    <record id="view_custom_pwa_manifest_screenshot_form" model="ir.ui.view">
        <field name="name">custom.pwa.manifest.screenshot.form</field>
        <field name="model">custom.pwa.manifest.screenshot</field>
        <field name="arch" type="xml">
            <form string="Screenshot Manifest PWA">
                <sheet>
                    <group>
                        <field name="name" placeholder="Accueil desktop"/>
                        <field name="image" widget="image"/>
                        <field name="sizes" placeholder="Ex: 1839x991 ou 860x1746"/>
                        <field name="type" placeholder="image/png"/>
                        <field name="form_factor"/>
                        <field name="label" placeholder="Texte affiché sous le screenshot"/>
                    </group>
                    <div class="alert alert-info mt16">
                        <ul>
                            <li>Ajoutez un screenshot pour chaque format : desktop (wide), mobile (narrow)…</li>
                            <li>Le champ <b>sizes</b> doit correspondre à la taille réelle de l'image.</li>
                            <li>Le champ <b>form_factor</b> indique le type d’écran : wide (desktop/tablette), narrow (mobile).</li>
                        </ul>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_custom_pwa_manifest_screenshot_list" model="ir.ui.view">
        <field name="name">custom.pwa.manifest.screenshot.list</field>
        <field name="model">custom.pwa.manifest.screenshot</field>
        <field name="arch" type="xml">
            <list string="Screenshots Manifest PWA">
                <field name="name"/>
                <field name="sizes"/>
                <field name="form_factor"/>
            </list>
        </field>
    </record>
    <record id="action_custom_pwa_manifest_screenshot" model="ir.actions.act_window">
        <field name="name">Screenshots Manifest PWA</field>
        <field name="res_model">custom.pwa.manifest.screenshot</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_custom_pwa_manifest_screenshot" name="Screenshots" parent="menu_custom_pwa_title_root" action="action_custom_pwa_manifest_screenshot" sequence="60"/>
</odoo>
