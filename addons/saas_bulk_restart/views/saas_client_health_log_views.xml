<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_saas_client_health_log_list" model="ir.ui.view">
        <field name="name">saas.client.health.log.list</field>
        <field name="model">saas.client.health.log</field>
        <field name="arch" type="xml">
            <list string="SaaS Health History" create="0" edit="0">
                <field name="event_date"/>
                <field name="client_id"/>
                <field name="event_type"/>
                <field name="health_state"/>
                <field name="http_status"/>
                <field name="failure_count"/>
                <field name="auto_restart_attempt_count"/>
                <field name="user_id"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="view_saas_client_health_log_form" model="ir.ui.view">
        <field name="name">saas.client.health.log.form</field>
        <field name="model">saas.client.health.log</field>
        <field name="arch" type="xml">
            <form string="SaaS Health History" create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="event_date"/>
                            <field name="client_id"/>
                            <field name="event_type"/>
                            <field name="health_state"/>
                        </group>
                        <group>
                            <field name="http_status"/>
                            <field name="failure_count"/>
                            <field name="auto_restart_attempt_count"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="url"/>
                        <field name="message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_saas_client_health_log_search" model="ir.ui.view">
        <field name="name">saas.client.health.log.search</field>
        <field name="model">saas.client.health.log</field>
        <field name="arch" type="xml">
            <search string="SaaS Health History">
                <field name="client_id"/>
                <field name="event_type"/>
                <field name="health_state"/>
                <field name="event_date"/>
                <filter name="offline" string="Offline" domain="[('health_state','=','offline')]"/>
                <filter name="restarted" string="Restarts" domain="[('event_type','in',('auto_restart','manual_restart'))]"/>
                <filter name="blocked" string="Blocked" domain="[('event_type','=','auto_restart_blocked')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_client" string="Client" context="{'group_by': 'client_id'}"/>
                    <filter name="group_event" string="Event" context="{'group_by': 'event_type'}"/>
                    <filter name="group_status" string="Real Status" context="{'group_by': 'health_state'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'event_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_saas_client_health_log" model="ir.actions.act_window">
        <field name="name">SaaS Health History</field>
        <field name="res_model">saas.client.health.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_client': 1}</field>
    </record>
</odoo>
