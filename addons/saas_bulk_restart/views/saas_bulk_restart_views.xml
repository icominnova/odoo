<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_saas_bulk_restart_wizard_form" model="ir.ui.view">
        <field name="name">saas.bulk.restart.wizard.form</field>
        <field name="model">saas.bulk.restart.wizard</field>
        <field name="arch" type="xml">
            <form string="Restart SaaS Clients">
                <group>
                    <field name="client_count" readonly="1"/>
                    <field name="client_ids" widget="many2many_tags" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button
                        name="action_restart_clients"
                        type="object"
                        string="Restart Selected"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
