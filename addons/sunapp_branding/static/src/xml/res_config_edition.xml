<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="sunapp_branding.res_config_edition" t-inherit="res_config_edition" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('user-heading')]/h3" position="replace">
            <h3 class="px-0">
                SunApp <t t-esc="serverVersion"/>
                (Community Edition)
            </h3>
        </xpath>
        <xpath expr="//small" position="replace">
            <small>
                Copyright &#169; 2026
                <a target="_blank" href="/" style="text-decoration: underline;">SunApp</a>
                <a id="license" target="_blank" href="http://www.gnu.org/licenses/lgpl.html" style="text-decoration: underline;">GNU LGPL Licensed</a>
            </small>
        </xpath>
    </t>
</templates>
