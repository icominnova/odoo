<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template
        id="external_layout_custom"
        inherit_id="web.external_layout_boxed">
        
        <xpath expr="//div[contains(@class,'footer')]"
               position="inside">
            <p class="footer_message">
                Toujours à votre service
            </p>
        </xpath>

        <xpath expr="//div[hasclass('row') and hasclass('mb8')]/div[1]" position="attributes">
            <attribute name="class" add="shoes_logo" separator=" "/>
        </xpath>
        
    </template>

    <template id="invoice_custom" inherit_id="account.document_tax_totals_template">
        <xpath expr="//tr[hasclass('o_total')]/td[1]" position="attributes">
            <attribute name="t-att-class">'shoes_invoice_total_label' if env.company.external_report_layout_id == env.ref('shoes_shop_coustom.external_layout_custom') else '' </attribute>
        </xpath>

        <xpath expr="//tr[hasclass('o_total')]/td[2]" position="attributes">
            <attribute name="t-att-class">'text-end shoes_invoice_total_amount' if env.company.external_report_layout_id == env.ref('shoes_shop_coustom.external_layout_custom') else 'text-end'</attribute>
        </xpath>
    </template>

    <template id="invoice_lines_numbering" inherit_id="account.report_invoice_document">

        <xpath expr="//table[@name='invoice_line_table']/thead/tr" position="attributes">
            <attribute name="class" add="shoes_invoice_header_row" separator=" "/>
        </xpath>

        <xpath expr="//table[@name='invoice_line_table']/thead//th[@name='th_description']" position="before">
            <th name="th_line_number" class="text-start">
                <span>N°</span>
            </th>
        </xpath>

        <xpath expr="//table[@name='invoice_line_table']/tbody/t[@t-foreach='lines_to_report']" position="before">
            <t t-set="shoes_line_number" t-value="0"/>
        </xpath>

        <xpath expr="//td[@name='account_invoice_line_name']" position="before">
            <t t-set="shoes_line_number" t-value="shoes_line_number + 1"/>
            <td name="td_line_number" t-att-class="padding_class">
                <span t-out="shoes_line_number"/>
            </td>
        </xpath>
    </template>

</odoo>