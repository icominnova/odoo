<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="saas_backup_browser_action" model="ir.actions.act_window">
        <field name="name">Parcourir backups</field>
        <field name="res_model">saas.backup.browser</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="saas_backup_browser_view_form" model="ir.ui.view">
        <field name="name">saas.backup.browser.form</field>
        <field name="model">saas.backup.browser</field>
        <field name="arch" type="xml">
            <form string="Ajouter des fichiers de sauvegarde">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <p>Sélectionnez une base pour voir les fichiers .zip disponibles, puis cliquez sur "Charger les fichiers".</p>
                    </div>
                    <group>
                        <group string="Parcourir">
                            <field name="client_folder" required="1"/>
                            <field name="recursive" string="Parcourir les sous-dossiers"/>
                            <field name="include_filestore" string="Inclure attachments (filestore)"/>
                        </group>
                    </group>
                    <group>
                        <button name="action_load_files" type="object" string="📁 Charger les fichiers" class="btn-primary"/>
                    </group>
                    <group string="Fichiers disponibles">
                        <field name="lines" nolabel="1">
                            <tree editable="bottom" create="false" delete="false">
                                <field name="selected" widget="boolean"/>
                                <field name="name"/>
                                <field name="source" widget="badge"/>
                                <field name="file_size_mb" string="Taille (Mo)"/>
                                <field name="backup_date"/>
                            </tree>
                        </field>
                    </group>
                    <footer>
                        <button name="action_import_selected" type="object" string="✓ Importer sélection" class="btn btn-primary"/>
                        <button string="Annuler" class="btn btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
