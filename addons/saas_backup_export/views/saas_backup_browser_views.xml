<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="saas_backup_browser_action" model="ir.actions.act_window">
        <field name="name">Parcourir backups</field>
        <field name="res_model">saas.backup.browser</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="saas_backup_browser_view_form" model="ir.ui.view">
        <field name="name">saas.backup.browser.form</field>
        <field name="model">saas.backup.browser</field>
        <field name="arch" type="xml">
            <form string="Parcourir les backups">
                <sheet>
                    <group>
                        <field name="client_folder"/>
                        <field name="recursive"/>
                        <field name="include_filestore"/>
                    </group>
                    <group>
                        <button name="action_load_files" type="object" string="Charger les fichiers" class="btn-primary"/>
                        <button name="action_import_selected" type="object" string="Importer sélection" class="btn-secondary"/>
                    </group>
                    <group string="Fichiers">
                        <field name="lines">
                            <tree editable="bottom">
                                <field name="selected"/>
                                <field name="source"/>
                                <field name="name"/>
                                <field name="file_size_mb"/>
                                <field name="backup_date"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Menu item pour Parcourir Backups -->
    <menuitem id="saas_backup_menu_browse" name="Parcourir Backups" parent="saas_backup_export.saas_backup_menu_root" action="saas_backup_browser_action" sequence="15"/>

</odoo>
