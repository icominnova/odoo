<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="saas_backup_browser_action" model="ir.actions.act_window">
        <field name="name">Parcourir backups</field>
        <field name="res_model">saas.backup.browser</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <record id="saas_backup_browser_line_tree_view" model="ir.ui.view">
        <field name="name">saas.backup.browser.line.tree</field>
        <field name="model">saas.backup.browser.line</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="false" delete="false">
                <field name="selected"/>
                <field name="client_name"/>
                <field name="name"/>
                <field name="relative_path"/>
                <field name="source" widget="badge"/>
                <field name="file_size_mb" string="Taille (Mo)"/>
                <field name="backup_date"/>
            </list>
        </field>
    </record>

    <record id="saas_backup_browser_view_form" model="ir.ui.view">
        <field name="name">saas.backup.browser.form</field>
        <field name="model">saas.backup.browser</field>
        <field name="arch" type="xml">
            <form string="Ajouter des fichiers de sauvegarde">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <p>Sélectionnez une base pour voir les fichiers .zip disponibles, puis exportez directement les fichiers cochés.</p>
                    </div>
                    <group>
                        <group string="Parcourir">
                            <field name="backup_process_id" options="{'no_create': True}"/>
                            <field name="database_name"/>
                            <field name="storage_path"/>
                            <field name="recursive" string="Parcourir les sous-dossiers"/>
                            <field name="include_filestore" string="Inclure attachments (filestore)"/>
                        </group>
                    </group>
                    <group>
                        <button name="action_load_files" type="object" string="Charger les fichiers" class="btn-primary"/>
                    </group>
                    <group string="Fichiers disponibles">
                        <field name="lines" nolabel="1">
                            <list editable="bottom" create="false" delete="false">
                                <field name="selected"/>
                                <field name="client_name"/>
                                <field name="name"/>
                                <field name="relative_path"/>
                                <field name="source" widget="badge"/>
                                <field name="file_size_mb" string="Taille (Mo)"/>
                                <field name="backup_date"/>
                            </list>
                        </field>
                    </group>
                    <footer>
                        <button name="action_export_selected" type="object" string="Exporter selection" class="btn btn-primary"/>
                        <button name="action_import_selected" type="object" string="Ajouter a la liste" class="btn btn-secondary"/>
                        <button string="Annuler" class="btn btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
