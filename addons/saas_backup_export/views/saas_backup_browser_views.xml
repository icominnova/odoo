<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="saas_backup_browser_action" model="ir.actions.act_window">
        <field name="name">Gérer les backups</field>
        <field name="res_model">saas.backup.browser</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <record id="saas_backup_browser_line_tree_view" model="ir.ui.view">
        <field name="name">saas.backup.browser.line.tree</field>
        <field name="model">saas.backup.browser.line</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="false" delete="false">
                <field name="selected"/>
                <field name="client_name"/>
                <field name="name"/>
                <field name="relative_path"/>
                <field name="source" widget="badge"/>
                <field name="file_size_mb" string="Taille (Mo)"/>
                <field name="backup_date"/>
            </list>
        </field>
    </record>

    <record id="saas_backup_browser_view_form" model="ir.ui.view">
        <field name="name">saas.backup.browser.form</field>
        <field name="model">saas.backup.browser</field>
        <field name="arch" type="xml">
            <form string="Gérer les backups SaaS">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <p>Sélectionnez un Backup Process, créez un backup complet ou chargez les backups existants, puis téléchargez les éléments cochés.</p>
                    </div>
                    <group>
                        <group string="Parcourir">
                            <field name="backup_process_id" options="{'no_create': True}"/>
                            <field name="database_name"/>
                            <field name="storage_path"/>
                        </group>
                        <group string="Sauvegarde automatique" invisible="not backup_process_id">
                            <field name="saas_auto_backup"/>
                            <field name="saas_backup_interval_number" invisible="not saas_auto_backup"/>
                            <field name="saas_backup_interval_type" invisible="not saas_auto_backup"/>
                            <field name="saas_backup_time" widget="float_time" invisible="not saas_auto_backup"/>
                            <field name="saas_next_backup_datetime" invisible="not saas_auto_backup"/>
                            <field name="saas_backup_retention" invisible="not saas_auto_backup"/>
                            <button name="action_save_auto_backup_schedule" type="object" string="Enregistrer la programmation" class="btn-primary" invisible="not saas_auto_backup"/>
                            <button name="action_recompute_next_backup" type="object" string="Recalculer prochaine sauvegarde" class="btn-secondary" invisible="not saas_auto_backup"/>
                            <button name="action_run_due_auto_backups" type="object" string="Lancer les sauvegardes dues" class="btn-secondary" invisible="not saas_auto_backup"/>
                        </group>
                    </group>
                    <group string="Dernière sauvegarde automatique" invisible="not backup_process_id or not saas_auto_backup">
                        <field name="saas_last_backup_datetime"/>
                        <field name="saas_last_backup_state" widget="badge" decoration-success="saas_last_backup_state == 'success'" decoration-danger="saas_last_backup_state == 'failed'"/>
                        <field name="saas_last_backup_message"/>
                    </group>
                    <group>
                        <button name="action_create_backup_now" type="object" string="Sauvegarder maintenant" class="btn-primary"/>
                        <button name="action_load_files" type="object" string="Charger les backups existants" class="btn-secondary"/>
                        <button name="action_export_selected" type="object" string="Télécharger la sélection" class="btn-primary"/>
                        <button name="action_delete_selected" type="object" string="Supprimer la sélection" class="btn-danger" confirm="Les backups cochés seront supprimés du serveur. Continuer ?"/>
                    </group>
                    <group string="Backups disponibles">
                        <field name="lines" nolabel="1">
                            <list editable="bottom" create="false" delete="false">
                                <field name="selected"/>
                                <field name="client_name"/>
                                <field name="name"/>
                                <field name="relative_path"/>
                                <field name="source" widget="badge"/>
                                <field name="file_size_mb" string="Taille (Mo)"/>
                                <field name="backup_date"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
