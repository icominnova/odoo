<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="saas_backup_import_wizard_view_form" model="ir.ui.view">
        <field name="name">saas.backup.import.wizard.form</field>
        <field name="model">saas.backup.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importer une sauvegarde ZIP">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Importez ici un ZIP Odoo provenant d’un autre serveur. Le fichier sera stocké dans le répertoire d’import du serveur puis analysé automatiquement.
                    </div>
                    <group>
                        <field name="upload_filename" invisible="1"/>
                        <field name="upload_file" filename="upload_filename"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_import" string="Importer et analyser" type="object" class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="saas_backup_import_wizard_action" model="ir.actions.act_window">
        <field name="name">Importer une sauvegarde ZIP</field>
        <field name="res_model">saas.backup.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
