<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="saas_backup_log_view_list" model="ir.ui.view">
        <field name="name">saas.backup.log.list</field>
        <field name="model">saas.backup.log</field>
        <field name="arch" type="xml">
            <list string="Historique des backups" create="false" edit="false" delete="true" decoration-success="state == 'success'" decoration-danger="state == 'failed'" decoration-info="state == 'running'">
                <header>
                    <button name="action_clear_all_logs" type="object" string="Vider l'historique" class="btn-danger" display="always" confirm="Vider tout l'historique des sauvegardes ? Cette action ne supprime pas les fichiers backup."/>
                </header>
                <field name="execution_datetime"/>
                <field name="scheduled_datetime"/>
                <field name="backup_process_id"/>
                <field name="database_name"/>
                <field name="event_type" widget="badge"/>
                <field name="state" widget="badge" decoration-success="state == 'success'" decoration-danger="state == 'failed'" decoration-info="state == 'running'"/>
                <field name="backup_file_id"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="saas_backup_log_view_form" model="ir.ui.view">
        <field name="name">saas.backup.log.form</field>
        <field name="model">saas.backup.log</field>
        <field name="arch" type="xml">
            <form string="Historique backup" create="false" edit="false" delete="true">
                <sheet>
                    <group>
                        <group string="Événement">
                            <field name="name"/>
                            <field name="event_type"/>
                            <field name="state" widget="badge" decoration-success="state == 'success'" decoration-danger="state == 'failed'" decoration-info="state == 'running'"/>
                        </group>
                        <group string="Contexte">
                            <field name="backup_process_id"/>
                            <field name="database_name"/>
                            <field name="backup_file_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="scheduled_datetime"/>
                        <field name="execution_datetime"/>
                    </group>
                    <group string="Message">
                        <field name="message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="saas_backup_log_view_search" model="ir.ui.view">
        <field name="name">saas.backup.log.search</field>
        <field name="model">saas.backup.log</field>
        <field name="arch" type="xml">
            <search string="Rechercher dans l'historique">
                <field name="backup_process_id"/>
                <field name="database_name"/>
                <field name="event_type"/>
                <field name="state"/>
                <filter string="Échecs" name="failed" domain="[('state', '=', 'failed')]"/>
                <filter string="Succès" name="success" domain="[('state', '=', 'success')]"/>
                <filter string="Programmation" name="schedule" domain="[('event_type', 'in', ['schedule_saved', 'schedule_recomputed'])]"/>
                <filter string="Sauvegardes auto" name="auto" domain="[('event_type', 'in', ['auto_started', 'auto_success', 'auto_failed'])]"/>
                <separator/>
                <filter string="Grouper par Process" name="group_process" context="{'group_by': 'backup_process_id'}"/>
                <filter string="Grouper par État" name="group_state" context="{'group_by': 'state'}"/>
                <filter string="Grouper par Jour" name="group_day" context="{'group_by': 'execution_datetime:day'}"/>
            </search>
        </field>
    </record>

    <record id="saas_backup_log_action" model="ir.actions.act_window">
        <field name="name">Historique</field>
        <field name="res_model">saas.backup.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

</odoo>
