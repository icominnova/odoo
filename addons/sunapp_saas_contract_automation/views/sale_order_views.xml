<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="sale_order_form_saas_domain" model="ir.ui.view">
        <field name="name">sale.order.form.sunapp.saas.domain</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="sunapp_saas_domain_name"/>
                <field name="sunapp_saas_automation_state" readonly="1"/>
                <field name="sunapp_saas_automation_error" readonly="1"
                       invisible="not sunapp_saas_automation_error"/>
            </xpath>
        </field>
    </record>
</odoo>
